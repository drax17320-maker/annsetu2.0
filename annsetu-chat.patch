diff --git a/web/components/site/website-chat.tsx b/web/components/site/website-chat.tsx
new file mode 100644
index 0000000..b629596
--- /dev/null
+++ b/web/components/site/website-chat.tsx
@@ -0,0 +1,25 @@
+import Script from "next/script";
+
+import styles from "./website-chat.module.css";
+
+const widgetStyles = "https://cdn.jsdelivr.net/npm/@n8n/chat@1.47.4/dist/style.css";
+
+export function WebsiteChat() {
+  const endpoint = process.env.NEXT_PUBLIC_N8N_CHAT_WEBHOOK_URL?.trim();
+  if (!endpoint) return null;
+
+  try {
+    const url = new URL(endpoint);
+    if (url.protocol !== "https:" || url.username || url.password) return null;
+  } catch {
+    return null;
+  }
+
+  return (
+    <>
+      <link rel="stylesheet" href={widgetStyles} precedence="default" />
+      <div id="annsetu-chat" className={styles.chat} data-webhook-url={endpoint} />
+      <Script src="/annsetu-chat.mjs" type="module" strategy="afterInteractive" />
+    </>
+  );
+}
diff --git a/web/public/annsetu-chat.mjs b/web/public/annsetu-chat.mjs
new file mode 100644
index 0000000..138cb4a
--- /dev/null
+++ b/web/public/annsetu-chat.mjs
@@ -0,0 +1,23 @@
+import { createChat } from "https://cdn.jsdelivr.net/npm/@n8n/chat@1.47.4/dist/chat.bundle.es.js";
+
+const container = document.getElementById("annsetu-chat");
+
+if (container?.dataset.webhookUrl) {
+  createChat({
+    target: "#annsetu-chat",
+    webhookUrl: container.dataset.webhookUrl,
+    loadPreviousSession: false,
+    showWelcomeScreen: false,
+    initialMessages: ["Hi! Ask me about donating surplus food, requesting food, or how pickups work."],
+    i18n: {
+      en: {
+        title: "Ask AnnSetu",
+        subtitle: "For general questions. Please leave out personal details.",
+        footer: "",
+        getStarted: "Start a chat",
+        inputPlaceholder: "Ask a question…",
+        closeButtonTooltip: "Close chat",
+      },
+    },
+  });
+}
